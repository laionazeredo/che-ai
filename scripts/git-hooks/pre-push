#!/usr/bin/env bash
#
# Che — pre-push hook (thorough, ~30 s).
#
# Runs BEFORE git push sends commits to origin. Mirrors the GitHub Actions
# CI jobs (python-ci + markdown-ci + security-ci offline subset). If this
# hook passes, CI will pass too (99 % of the time).
#
# Installed by `scripts/install-git-hooks.sh` or `scripts/install-che.sh`.
#
# CAN BE BYPASSED with `git push --no-verify`. Reserved for:
#   • fixing a failing CI config that has nothing to do with the push,
#   • pushing a temporary / draft branch to PR-preview,
#   • verified-false-positive secret hit.

set -euo pipefail

RED=$'\033[0;31m'; YEL=$'\033[1;33m'; GRN=$'\033[0;32m'; DIM=$'\033[2m'; RST=$'\033[0m'

info()   { printf '%s[hooks/pre-push]%s    %s\n'    "${DIM}"  "${RST}" "$*"; }
ok()     { printf '%s[hooks/pre-push] %sOK%s     %s\n' "${DIM}"  "${GRN}" "${RST}" "$*"; }
warn()   { printf '%s[hooks/pre-push] %sWARN%s   %s\n' "${DIM}"  "${YEL}" "${RST}" "$*"; }
fail()   { printf '%s[hooks/pre-push] %sFAIL%s   %s\n' "${DIM}"  "${RED}" "${RST}" "$*" >&2; }

START=$SECONDS

if [[ -n "${CHE_SKIP_PRE_PUSH:-}" ]]; then
  warn "CHE_SKIP_PRE_PUSH is set — skipping all pre-push checks."
  exit 0
fi

# ---------------------------------------------------------------------------
# Resolve repo root + fail-fast dev-dependency check.
# We run from .git/hooks/pre-push; repo root is ../.. from there.
# ---------------------------------------------------------------------------

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${HOOK_DIR}/../.." && pwd)"
DEPS_CHECK="${REPO_ROOT}/scripts/check-dev-dependencies.sh"

if [[ -f "${DEPS_CHECK}" ]]; then
  bash "${DEPS_CHECK}"   # STRICT mode — missing REQUIRED = block push now.
fi

info "Running CI-mirror gates (ruff lint+format, full pytest, markdownlint, secret regex)…"
info "Expected ~30 s on a warm cache.  Bypass once:  git push --no-verify"

# ---------------------------------------------------------------------------
# 1. Ruff lint — whole repo, matches CI.
# ---------------------------------------------------------------------------

info "ruff check .  (matches GitHub Actions job python-ci step 3)"
if ! command -v ruff >/dev/null 2>&1; then
  warn "ruff not found on PATH —  pipx install ruff"
else
  if ! ruff check .; then
    fail "ruff check failed (same as CI step). Fix, commit, re-push."
    exit 1
  fi
  ok "ruff check"
fi

# ---------------------------------------------------------------------------
# 2. Ruff format check — whole repo, matches CI.
# ---------------------------------------------------------------------------

info "ruff format --check .  (matches python-ci step 4)"
if command -v ruff >/dev/null 2>&1; then
  if ! ruff format --check . 2>&1; then
    fail "ruff format check failed. Run:  ruff format .  then commit + push."
    exit 1
  fi
  ok "ruff format check"
fi

# ---------------------------------------------------------------------------
# 3. Full pytest suite — 39 tests, ~2 s.  Exactly mirrors python-ci step 5.
# ---------------------------------------------------------------------------

info "python3 -m pytest tests/ -q  (exactly python-ci step 5, 39 tests)"
if command -v pytest >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1; then
  if ! python3 -m pytest tests/ -q --tb=short 2>&1 | tail -25; then
    fail "pytest failed (39 expected pass). Fix before push or draft-PR with --no-verify."
    exit 1
  fi
  ok "pytest full suite"
fi

# ---------------------------------------------------------------------------
# 4. Markdown lint — mirrors GitHub Actions job `markdown-ci`.
#    Same globs, same action version (markdownlint-cli2 v17 equiv).
# ---------------------------------------------------------------------------

info "markdownlint-cli2  (exact same globs as markdown-ci job in .github/workflows/ci.yml)"
if ! command -v npx >/dev/null 2>&1; then
  warn "npx / Node not on PATH — install Node 20+ to match the markdown-ci job."
else
  # Exact globs from ci.yml lines 44-48:
  #   **/*.md
  #   !node_modules/**
  #   !__pycache__/**
  #   !.github/**
  set +e
  MD_OUTPUT=$(
    npx --yes markdownlint-cli2 \
      "**/*.md" \
      "!node_modules/**" \
      "!__pycache__/**" \
      "!.github/**" 2>&1
  )
  MD_RC=$?
  set -e

  if (( MD_RC != 0 )); then
    # Split issues into (a) files introduced/modified by this push vs (b) legacy.
    # Legacy files still make the hook fail — you asked to mirror CI.
    # But we PRINT a friendly pointer so you can tell what is new vs noise.
    NEW_FILES=$(git diff --name-only origin/main...HEAD 2>/dev/null | grep -E '\.md$' || echo "")
    echo ""
    echo "${MD_OUTPUT}" | tail -80
    echo ""
    if [[ -n "${NEW_FILES}" ]]; then
      warn "Markdown issues in files touched by THIS push:"
      echo "${NEW_FILES}" | sed 's/^/  • /'
    fi
    fail "markdownlint-cli2 failed (same as GitHub Actions markdown-ci job)."
    exit 1
  fi
  ok "markdownlint-cli2"
fi

# ---------------------------------------------------------------------------
# 5. Secret scan, offline — regex based (TruffleHog is CI-only because it
#    requires a Go binary install + optional network call for `--only-verified`).
#    Same intent: never push a known secret shape.
# ---------------------------------------------------------------------------

info "secret regex scan  (offline subset of security-ci TruffleHog step)"
PATTERN='(\bgh[pors]_[A-Za-z0-9]{36,}|\bAKIA[0-9A-Z]{16}|sk-[A-Za-z0-9]{20,}|BEGIN (RSA|OPENSSH|EC|PGP|DSA) PRIVATE KEY|eyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}|\bxox[bpar]-[A-Za-z0-9-]{10,})'

# Scan the DIFF that is being PUSHED (not the whole repo — that's CI's job).
PUSH_RANGE=$(git rev-list --count origin/$(git rev-parse --abbrev-ref HEAD)..HEAD 2>/dev/null || echo "0")
FOUND=""
if [[ -n "${PUSH_RANGE}" && "${PUSH_RANGE}" != "0" ]]; then
  FOUND=$(
    git diff --no-color origin/$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)...HEAD -- 2>/dev/null \
      | grep -E '^\+[^+]' \
      | grep -E "${PATTERN}" \
      || true
  )
else
  # Fallback: scan working copy if no origin yet (first push on a fork).
  FOUND=$(
    git grep -nE "${PATTERN}" -- ':!node_modules' ':!__pycache__' ':!.git' 2>/dev/null || true
  )
fi

if [[ -n "${FOUND}" ]]; then
  fail "Possible secret in diff being pushed (matches GitHub PAT / AWS key / PEM / JWT / Slack token)."
  echo ""
  echo "Hits (review; if test/fake use  git push --no-verify  once):"
  echo "${FOUND}" | head -40
  exit 1
fi
ok "secret regex scan"

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

ELAPSED=$(( SECONDS - START ))
ok "all CI-mirror gates passed in ~${ELAPSED} s.  Bypass once if CI-config-only push:  git push --no-verify"
exit 0
